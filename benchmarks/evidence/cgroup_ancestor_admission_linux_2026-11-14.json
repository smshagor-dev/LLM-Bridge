  },
  "scope": "Cgroup-v2 parser, filesystem and admission-policy regression coverage. No privileged kernel cgroup setup or physical 2GB proof. Hidden ancestors/v1/atomic snapshots remain unsupported. No visible cgroup2 filesystem exists on this validation host, so real-model trials validate host-RAM behavior and numerical regressions only.",
  "host_visible_cgroup2_mount": false,
  "regression_test_results": [
    "test cgroup_memory::tests::ancestor_observation_drives_context_and_allocation_admission ... ok",
    "test cgroup_memory::tests::ancestor_usage_includes_siblings_and_is_not_subtracted_from_leaf_limit ... ok",
    "test cgroup_memory::tests::malformed_limit_is_not_confused_with_unlimited ... ok",
    "test cgroup_memory::tests::namespaced_root_and_escaped_mount_are_resolved_without_walking_above_mount ... ok",
    "test cgroup_memory::tests::no_visible_v2_retains_only_host_observation ... ok",
    "test cgroup_memory::tests::rejects_unsafe_deleted_duplicate_or_unresolvable_membership ... ok",
    "test cgroup_memory::tests::unlimited_leaf_still_observes_parent_and_exhaustion_saturates ... ok",
    "test cgroup_memory::tests::unreadable_malformed_or_disappeared_finite_ancestor_fails_closed ... ok",
    "test cgroup_memory::tests::widest_mount_exposes_more_ancestors_and_prefixes_are_component_aware ... ok",
    "test cgroup_memory::tests::true_root_and_disabled_controller_have_no_fabricated_limit ... ok",
    "test cgroup_memory::tests::real_files_follow_parent_updates_and_reject_disappearance_and_oversize ... ok",
    "test cgroup_memory::tests::hierarchy_walk_is_bounded ... ok"
  ],
